{
	"name": "max-video-player",
	"private": true,
	"license": "GPL-3.0-only",
	"description": "IPTV player for desktop and iOS, built with Tauri and mpv",
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
	"scripts": {
		"prepare": "husky",
		"format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"site/**/*.{ts,js,mjs,json,css,html,md}\"",
		"format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"site/**/*.{ts,js,mjs,json,css,html,md}\"",
		"check:changed": "bash scripts/check-changed.sh",
		"lint": "eslint apps/player/src site",
		"lint:fix": "eslint apps/player/src site --fix",
		"dev:desktop": "pnpm --filter ./apps/player tauri dev",
		"dev:desktop:web": "pnpm --filter ./apps/player dev",
		"build:desktop": "pnpm --filter ./apps/player build",
		"tauri:desktop": "pnpm --filter ./apps/player tauri",
		"test": "cargo test -p mvp-core && pnpm --filter ./apps/player test && pnpm --filter ./site test",
		"test:core": "cargo test -p mvp-core",
		"test:desktop": "pnpm --filter ./apps/player test",
		"test:desktop:mutation": "pnpm --filter ./apps/player test:mutation",
		"dev:site": "pnpm --filter ./site dev",
		"build:site": "pnpm --filter ./site build",
		"test:site": "pnpm --filter ./site test",
		"test:site:mutation": "pnpm --filter ./site test:mutation"
	},
	"lint-staged": {
		"apps/**/*.{ts,tsx,js,jsx,json,css,md}": [
			"prettier --write"
		],
		"apps/**/*.{ts,tsx}": [
			"eslint --fix"
		],
		"site/**/*.{ts,js,mjs,json,css,html,md}": [
			"prettier --write"
		],
		"site/**/*.{ts,mjs}": [
			"eslint --fix"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.2"
	}
}
