# lint-staged runs with --no-stash so it never adds to or drops from the git
# stash, which other worktrees share. It still hides the unstaged parts of
# partially staged files while the tasks run, and puts them back afterwards,
# even when a task fails. If it can't, it says so and leaves them in a patch
# under the git directory's lint-staged folder.
pnpm exec lint-staged --no-stash

pnpm test
