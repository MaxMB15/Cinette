{
	"$schema": "https://raw.githubusercontent.com/nichobi/tauri-apps/tauri-v2/core/tauri-config-schema/schema.json",
	"productName": "Max Video Player",
	"version": "0.6.0",
	"identifier": "com.maxvideoplayer.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"beforeBundleCommand": {
			"script": "bash scripts/bundle-libmpv.sh",
			"cwd": "../../.."
		},
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "Max Video Player",
				"width": 1280,
				"height": 720,
				"resizable": true,
				"fullscreen": false,
				"decorations": true,
				"transparent": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMjJBQTczNDYzMjgxRkIKUldUN2dUSkdjNm9pN1pZRlYyZnEvb0lYbWcreENJd0ZwVHdWeXFLT0U0U1hLWHF0YjA5TE1jU2YK",
			"endpoints": [
				"https://github.com/MaxMB15/MaxVideoPlayer/releases/latest/download/latest.json"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"copyright": "Copyright (C) 2026 Max Boksem",
		"license": "GPL-3.0-only",
		"resources": {
			"../../../LICENSE": "LICENSE",
			"../../../NOTICE": "NOTICE",
			"../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
			"../../../TRADEMARKS.md": "TRADEMARKS.md"
		},
		"externalBin": ["binaries/max-video-player-ffmpeg"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],

		"macOS": {
			"entitlements": "./Entitlements.plist",
			"frameworks": [],
			"files": {
				"Frameworks": "../../../libs/macos-bundle"
			},
			"infoPlist": "./Info.plist",
			"minimumSystemVersion": "15.0"
		},
		"linux": {
			"deb": {
				"depends": [
					"libmpv2 | libmpv1",
					"libegl1",
					"libgtk-3-0",
					"libwebkit2gtk-4.1-0 (>= 2.40)",
					"libpulse0 | libasound2",
					"libass9"
				]
			},
			"rpm": {
				"depends": [
					"mpv-libs",
					"mesa-libEGL",
					"gtk3",
					"(webkit2gtk4.1 >= 2.40)",
					"pulseaudio-libs",
					"libass"
				]
			}
		}
	}
}
