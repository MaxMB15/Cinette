# Dependencies
node_modules/
target/

# Build output
dist/
*.tsbuildinfo

# Tauri
apps/player/src-tauri/gen/*
# The Xcode project is hand-edited (MPVKit, signing), so it's checked in.
!apps/player/src-tauri/gen/apple/
apps/player/src-tauri/target/

# The app's folder before it moved to apps/player. Older checkouts keep their
# ignored files in it until it's deleted.
/apps/desktop/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log

# Test coverage
coverage/

# cargo-mutants results
mutants.out/
mutants.out.old/

# Bundled resources
apps/player/resources/

# ffmpeg sidecar binaries (fetched via scripts/fetch-ffmpeg.sh)
apps/player/src-tauri/binaries

# libmpv built by scripts/build-libmpv.sh, and the source it builds from
/libs

# Worktrees
.worktrees/

# Copied in by tauri-plugin-mpv's build script for the iOS Swift package
crates/tauri-plugin-mpv/.tauri/
